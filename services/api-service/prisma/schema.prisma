/// Assessment-bank taxonomy: tags Assessment and Question rows only.
///
/// NOT the same concept as `LearningSubject`, despite the name — there is no relation between the
/// two and no code path converts one to the other. `LearningSubject` is the catalogue taxonomy
/// (Course, LearningPath, ClassSection); this one exists purely to categorise the question bank.
/// Renaming this to `AssessmentSubject` is the eventual fix; until then, check which of the two you
/// mean before adding a relation to either.
model Subject {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]
  questions   Question[]

  @@map("subjects")
}

/// Academic level master — the top of the Class -> Program -> Course taxonomy.
///
/// Absorbs the former `Level` model, whose rows were always grade levels
/// (K, G1, G3, G5, G10, G11) but which was wired only to
/// Assessment/Question/PlacementRecommendation. Merging it here removed one of
/// three competing level concepts. `Course.gradeBand` deliberately survives —
/// see the comment on that field.
model Class {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  slug        String        @unique
  description String?
  sortOrder   Int           @default(0)
  status      CatalogStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  programs                 Program[]
  studentProfiles          StudentProfile[]
  assessments              Assessment[]
  questions                Question[]
  placementRecommendations PlacementRecommendation[]

  @@map("classes")
}

