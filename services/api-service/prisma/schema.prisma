model Question {
  id             String      @id @default(uuid())
  subjectId      String
  classId        String
  questionType   String // mcq, short_answer, numeric
  prompt         String
  // Decorative, not part of the answer key — safe to send to a student
  // before they submit, unlike widgetConfig's secret fields. Lets a prompt
  // reference a diagram/figure the text alone can't carry (a polygon to
  // classify, a labeled angle, a shape to read) without needing a dedicated
  // widget type for every "look at this and answer" question.
  promptImageUrl String?
  correctAnswer  String?
  difficulty     String      @default("medium") // easy, medium, hard
  status         String      @default("active") // active, archived
  widgetType     WidgetType? @default(STANDARD_MCQ)
