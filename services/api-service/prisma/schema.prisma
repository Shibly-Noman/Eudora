// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String?
  /// Deprecated: superseded by UserIdentity. Retained for one release so a
  /// rollback keeps working; drop once no code reads it.
  googleId           String?   @unique
  firstName          String
  lastName           String
  avatarUrl          String?
  isActive           Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles                       UserRole[]
  identities                  UserIdentity[]
  studentProfile              StudentProfile?
  guardianProfile             GuardianProfile?
  teacherProfile              TeacherProfile?
  authSessions                AuthSession[]
  assignedAssignments         AssessmentAssignment[]    @relation("AssignedAssignments")
  markedAttempts              AssessmentAttempt[]       @relation("MarkedAttempts")
  notifications               Notification[]
  deviceTokens                DeviceToken[]
  devicePairingCodes          DevicePairingCode[]
  passwordResetTokens         PasswordResetToken[]
  fileUploads                 FileUpload[]
  hostedLiveClassSessions     BatchSession[]            @relation("HostedLiveClassSessions")
  assignedCourses             StudentCourseAssignment[] @relation("AssignedCourses")
  grantedEntitlements         Entitlement[]             @relation("GrantedEntitlements")
  orders                      Order[]                   @relation("GuardianOrders")
  teacherApplication          TeacherApplication?       @relation("TeacherApplicant")
  homeworkSubmissionsMade     HomeworkSubmission[]      @relation("HomeworkSubmittedBy")
  reviewedTeacherApplications TeacherApplication[]      @relation("TeacherApplicationReviewer")

  @@map("users")
}

enum AuthProvider {
  GOOGLE
  APPLE
}

/// A federated identity linked to a user. One row per (provider, account).
model UserIdentity {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String // Google `sub` / Apple `sub`
  email          String? // email as asserted by the provider, may differ from User.email
  emailVerified  Boolean      @default(false)
  isPrivateRelay Boolean      @default(false) // Apple "Hide My Email" relay address
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. SUPER_ADMIN, ADMIN, USER
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String // e.g. "create", "read", "update", "delete"
  subject     String // e.g. "User", "Role", "Permission"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum EducationalInstitutionStatus {
  ACTIVE
  INACTIVE
}

/// How a Program or Course is consumed. Drives both the duration semantics and
/// what a purchase grants: SELF_PACED sells an access window starting at
/// purchase (permanent once fully paid), LIVE sells a seat in a dated batch and
/// access ends with that batch.
enum DeliveryMode {
  SELF_PACED
  LIVE
  HYBRID
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

enum CourseTermStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum BatchStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

enum PlacementStatus {
  PLACED
  PENDING
  WITHDRAWN
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// The primary sellable SKU. A Program bundles Courses (via `ProgramCourse`)
/// and carries the price, duration and marketing copy that the public catalog
/// and checkout render.
model Program {
  id      String  @id @default(uuid())
  /// Nullable on purpose: a Program with no Class is a standalone bundle — the
  /// K-6 micro-course packs — which sits outside the academic
  /// Class -> Program tree but reuses the same SKU machinery.
  classId String?
  name    String
  code    String  @unique
  slug    String  @unique

  /// Marketing surface. `shortDescription` is the SEO meta description;
  /// `description` is the long body on the public program page.
  shortDescription String?
  description      String?
  thumbnailUrl     String?
  outcomes         String[]
  /// The formal/board syllabus PDF parents look for. Course outlines are
  /// derived from the Concept tree instead of authored — this is the only
  /// hand-supplied syllabus artefact.
  syllabusFileId   String?

  deliveryMode   DeliveryMode @default(SELF_PACED)
  /// Null when there is no fixed calendar length — self-paced bundles with
  /// permanent access.
  durationMonths Int?

  /// Money is always integer minor units (cents). Never `Decimal` — Stripe
  /// works in the smallest currency unit and the two round differently.
  /// Billing mode is derived, not stored: a monthly price present means
  /// installments are offered, absent means one-time only.
  priceOneTimeCents Int?
  priceMonthlyCents Int?
  installmentCount  Int?
  currency          String @default("USD")

  stripeProductId      String?
  stripePriceOneTimeId String?
  stripePriceMonthlyId String?

  status      CatalogStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedById String?

  class          Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  syllabusFile   FileUpload?     @relation("ProgramSyllabus", fields: [syllabusFileId], references: [id], onDelete: SetNull)
  classSections  ClassSection[]
  programCourses ProgramCourse[]
  entitlements   Entitlement[]
  orderItems     OrderItem[]

  @@index([classId])
  @@index([status])
  @@map("programs")
}

/// How a purchase is paid for. Derived from which price fields a SKU has set,
/// never chosen freely: a monthly price present means installments are offered.
/// SUBSCRIPTION is declared but has no handler — the K-6 tier is one-time only
/// (decision 4b). Keeping the value avoids a migration if that is revisited.
enum BillingMode {
  ONE_TIME
  INSTALLMENT
  SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAST_DUE
  CANCELLED
}

/// A checkout attempt. Keyed to the guardian who pays, while the Entitlement it
/// produces is keyed to the student who consumes — one guardian, three
/// children, one order.
model Order {
  id             String      @id @default(uuid())
  guardianUserId String
  status         OrderStatus @default(PENDING)
  /// Sum of the order's item prices in integer minor units, after any upgrade
  /// credit. There is no tax or shipping, so this is the amount charged.
  totalCents     Int
  currency       String      @default("USD")

  stripeCheckoutSessionId String? @unique
  stripeCustomerId        String?
  stripePaymentIntentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardian User        @relation("GuardianOrders", fields: [guardianUserId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@index([guardianUserId, status])
  @@map("orders")
}

model OrderItem {
  id               String @id @default(uuid())
  orderId          String
  /// The child this purchase is for, chosen in the cart rather than after
  /// payment — buying and then not knowing where the course went is the
  /// classic failure here.
  studentProfileId String

  /// Exactly one of programId / courseId, same rule as Entitlement.
  programId String?
  courseId  String?
  /// LIVE purchases consume a seat in a specific batch. Wired in Phase 5.
  batchId   String?

  billingMode      BillingMode
  /// What is actually charged for this line, after `creditAppliedCents`.
  priceCents       Int
  installmentCount Int?

  /// Set when upgrading from already-owned a-la-carte courses into the program
  /// that contains them, so the buyer is not charged twice for the overlap.
  creditAppliedCents      Int     @default(0)
  creditFromEntitlementId String?

  createdAt DateTime @default(now())

  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  program        Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  course         Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  entitlement    Entitlement?
  plan           InstallmentPlan?

  @@index([orderId])
  @@map("order_items")
}

/// A fixed-length installment plan, NOT an open-ended subscription: it carries
/// a `cancel_at` in Stripe so it self-terminates after the final payment, at
/// which point self-paced access becomes permanent.
model InstallmentPlan {
  id          String @id @default(uuid())
  orderItemId String @unique

  stripeSubscriptionId String @unique

  installmentCount          Int
  installmentsPaid          Int @default(0)
  amountPerInstallmentCents Int
  /// Absorbs the rounding remainder: 10000 over 3 is 3333 + 3333 + 3334.
  finalInstallmentCents     Int

  status          PlanStatus @default(ACTIVE)
  paidThroughDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("installment_plans")
}

/// Idempotency ledger. Stripe retries deliveries, and granting an entitlement
/// twice is the failure mode here that costs real money.
model StripeWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@map("stripe_webhook_events")
}

enum EntitlementSource {
  PURCHASE
  ADMIN_GRANT
  TRIAL
  PROMO
}

enum EntitlementStatus {
  ACTIVE
  /// An installment payment failed. Access is withheld but the row is kept so
  /// a successful retry restores it without re-purchasing.
  PAST_DUE
  EXPIRED
  REVOKED
}

/// The access grant. Course content is otherwise open to any authenticated
/// student, so this is what makes a purchase mean anything — every content
/// route resolves through `EntitlementService`.
///
/// Deliberately distinct from `StudentCourseAssignment` (a guardian's "work on
/// this next" planner, which grants nothing) and from `StudentCourseEnrollment`
/// (a seat in a term-bound class).
///
/// NOT registered in `SOFT_DELETE_MODELS`: revoking access is a `status`
/// transition, not a delete, so the history stays queryable for support and
/// refund disputes.
model Entitlement {
  id               String  @id @default(uuid())
  studentProfileId String
  /// Exactly one of programId / courseId is set — enforced by a CHECK
  /// constraint in the migration, since Prisma cannot express it.
  programId        String?
  courseId         String?
  /// Set for LIVE purchases; the batch's end date is what `accessExpiresAt`
  /// tracks. Wired up in Phase 5.
  batchId          String?
  /// The purchase this grant came from. Null for ADMIN_GRANT / TRIAL / PROMO.
  orderItemId      String? @unique

  source EntitlementSource
  status EntitlementStatus @default(ACTIVE)

  accessStartsAt  DateTime  @default(now())
  /// Null = permanent. Self-paced access stays permanent once fully paid;
  /// live access expires with its batch.
  accessExpiresAt DateTime?
  /// While an installment plan is running, access is only live up to here.
  /// Null once the plan completes (or for one-time purchases).
  paidThroughDate DateTime?

  /// Who granted it, for ADMIN_GRANT. Kept so support actions are auditable.
  grantedByUserId String?
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  program        Program?       @relation(fields: [programId], references: [id], onDelete: Cascade)
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch          Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  orderItem      OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  grantedBy      User?          @relation("GrantedEntitlements", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, programId])
  @@unique([studentProfileId, courseId])
  @@index([studentProfileId, status])
  @@map("entitlements")
}

/// Courses are reusable across Programs (Class 9 and Class 10 Science both
/// teach Physics), so this is a join rather than a `programId` on Course.
/// Same shape as the existing `LearningPathCourse`.
model ProgramCourse {
  id         String   @id @default(uuid())
  programId  String
  courseId   String
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
  @@index([courseId])
  @@map("program_courses")
}

model AcademicYear {
  id          String                       @id @default(uuid())
  name        String                       @unique
  startDate   DateTime
  endDate     DateTime
  status      EducationalInstitutionStatus @default(ACTIVE)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?
  deletedById String?

  classSections     ClassSection[]
  terms             Term[]
  studentPlacements StudentClassPlacement[]

  @@map("academic_years")
}

model ClassSection {
  id                String      @id @default(uuid())
  programId         String
  academicYearId    String
  name              String
  code              String      @unique
  /// DEPRECATED — superseded by `program.class` now that `Class` is the taxonomy
  /// master. Kept (not dropped) because `Program.classId` is nullable and
  /// backfilled only where every section under a program agreed on one grade;
  /// dropping this before admins have assigned a Class to every Program would
  /// lose the value with nothing to derive it from. Remove in a follow-up once
  /// `Program.classId` is fully populated. Read `program.class.name` in new code.
  class             String?
  classroom         String?
  /// Subject this section teaches. Nullable because `Program` can span multiple subjects, so the
  /// tag has to sit per-section rather than being inherited from the program, and because every
  /// section that existed before this column was added has no subject until an admin sets one.
  learningSubjectId String?
  status            ClassStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  deletedById       String?

  program                  Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear             AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  learningSubject          LearningSubject?          @relation(fields: [learningSubjectId], references: [id], onDelete: SetNull)
  placements               StudentClassPlacement[]
  dailyAttendance          DailyAttendance[]
  teachers                 ClassTeacher[]
  placementRecommendations PlacementRecommendation[]

  @@index([learningSubjectId])
  @@map("class_sections")
}

model Term {
  id             String           @id @default(uuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         CourseTermStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  batches          Batch[]
  assessments      Assessment[]
  gradeBookEntries GradeBookEntry[]

  @@map("terms")
}

/// A dated cohort of a Course.
///
/// Previously `CourseClass`, renamed in its own dedicated pass once the
/// commerce work had settled. The old name collided with `Class` (the grade
/// level) and `ClassSection` (the roster) — three unrelated models sharing one
/// word, which made it easy to reach for the wrong one.
model Batch {
  id                  String      @id @default(uuid())
  /// Nullable only because every row predating the catalogue weld has no
  /// course. New batches always carry one — the API requires it. This link is
  /// what finally joins the catalogue tree to the operational one.
  courseId            String?
  /// Nullable now: a rolling batch belongs to no school term.
  termId              String?
  name                String
  code                String      @unique
  status              BatchStatus @default(ACTIVE)
  description         String?
  /// Null = unlimited. Guardian self-enrollment (`isOpenForEnrollment`)
  /// checks this; staff-mediated enrollment does not.
  capacity            Int?
  /// Default false is the safety valve for guardian self-enrollment: this
  /// migration makes nothing newly self-enrollable. Staff opt each class in
  /// deliberately.
  isOpenForEnrollment Boolean     @default(false)

  /// A LIVE purchase buys a seat in a dated cohort, and `endDate` is what the
  /// resulting entitlement's `accessExpiresAt` tracks — live access ends with
  /// the batch, unlike self-paced which is permanent once paid.
  startDate              DateTime?
  endDate                DateTime?
  /// The weekly pattern this cohort meets on. Sessions are not implied by it —
  /// it is the rule used to *generate* BatchSession rows across startDate..endDate,
  /// after which each session is edited independently. Empty means ad-hoc only.
  meetingDays            DayOfWeek[]
  /// Minutes past local midnight, so a pattern survives daylight-saving shifts
  /// in a way a stored timestamp would not.
  meetingStartMinutes    Int?
  meetingDurationMinutes Int?

  /// After this, the batch stops accepting new seats even if capacity remains.
  enrollmentDeadline DateTime?

  leadTeacherProfileId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  course           Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  term             Term?                     @relation(fields: [termId], references: [id], onDelete: SetNull)
  leadTeacher      TeacherProfile?           @relation("LeadBatchTeacher", fields: [leadTeacherProfileId], references: [id], onDelete: SetNull)
  enrollments      StudentCourseEnrollment[]
  entitlements     Entitlement[]
  sessions         BatchSession[]
  homeworks        Homework[]
  gradeBookEntries GradeBookEntry[]

  @@index([courseId, status])
  @@index([startDate])
  @@map("batches")
}

/// Teachers attached to a Course. This is the actual answer to "one course,
/// many teachers" — a join table, not a cohort system. `Batch` above is
/// a cohort and earns its place separately, through live delivery.
model CourseTeacher {
  courseId         String
  teacherProfileId String
  /// LEAD | ASSISTANT
  role             String   @default("LEAD")
  assignedAt       DateTime @default(now())

  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@id([courseId, teacherProfileId])
  @@index([teacherProfileId])
  @@map("course_teachers")
}

model StudentProfile {
  id                    String        @id @default(uuid())
  userId                String        @unique
  fullName              String
  birthDate             DateTime
  gender                Gender
  /// The child's grade level, captured when a guardian adds them.
  ///
  /// Deliberately a direct link rather than going through
  /// `StudentClassPlacement -> ClassSection`: that path is the operational
  /// roster and needs a Program and an AcademicYear, which a consumer signup
  /// has neither of. A guardian buying a course just needs to say "Grade 3".
  classId               String?
  status                StudentStatus @default(ACTIVE)
  // Self-service profile-completion fields (mobile/web Settings) — nullable
  // because every existing StudentProfile was created without them.
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  deletedById           String?

  user                     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  class                    Class?                        @relation(fields: [classId], references: [id], onDelete: SetNull)
  placements               StudentClassPlacement[]
  enrollments              StudentCourseEnrollment[]
  guardians                GuardianStudentRelationship[]
  dailyAttendance          DailyAttendance[]
  courseAttendance         BatchAttendance[]
  homeworkSubmissions      HomeworkSubmission[]
  assessmentAttempts       AssessmentAttempt[]
  assessmentAssignments    AssessmentAssignment[]
  gradeBookEntries         GradeBookEntry[]
  lessonAttempts           LessonAttempt[]
  streak                   StudentStreak?
  experience               StudentExperience?
  placementRecommendations PlacementRecommendation[]
  moduleItemProgress       ModuleItemProgress[]
  discussionPosts          DiscussionPost[]
  courseAssignments        StudentCourseAssignment[]
  entitlements             Entitlement[]
  orderItems               OrderItem[]
  storyConversations       StoryConversation[]

  @@index([classId])
  @@map("student_profiles")
}

model StudentClassPlacement {
  studentProfileId String
  classSectionId   String
  academicYearId   String
  status           PlacementStatus @default(PENDING)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, classSectionId])
  @@map("student_class_placements")
}

model StudentCourseEnrollment {
  id               String           @id @default(uuid())
  studentProfileId String
  batchId          String
  enrollmentDate   DateTime         @default(now())
  status           EnrollmentStatus @default(ENROLLED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, batchId])
  @@map("student_course_enrollments")
}

model GuardianProfile {
  id          String         @id @default(uuid())
  userId      String         @unique
  fullName    String
  email       String?
  phone       String?
  status      GuardianStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  deletedById String?

  user     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  students GuardianStudentRelationship[]

  @@map("guardian_profiles")
}

model GuardianStudentRelationship {
  id                         String           @id @default(uuid())
  guardianProfileId          String
  studentProfileId           String
  relationshipType           RelationshipType
  isPrimary                  Boolean          @default(false)
  hasFinancialResponsibility Boolean          @default(false)
  hasAcademicAccess          Boolean          @default(true)
  hasEmergencyContact        Boolean          @default(false)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  guardianProfile GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([guardianProfileId, studentProfileId])
  @@map("guardian_student_relationships")
}

// ─── Teacher ────────────────────────────────────────────────────────────────

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model TeacherProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  fullName       String
  employeeCode   String?       @unique
  phone          String?
  specialization String? // e.g. "Mathematics", "Computer Science"
  status         TeacherStatus @default(ACTIVE)
  joinDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  classAssignments ClassTeacher[]
  courseTeachers   CourseTeacher[]
  leadBatches      Batch[]         @relation("LeadBatchTeacher")

  @@map("teacher_profiles")
}

enum TeacherApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/**
 * Someone asking to teach here. Deliberately NOT a TeacherProfile: the TEACHER
 * role reaches student names, attendance and grades, so it is granted by a
 * human reviewing this row, never by the act of submitting one. Approval is
 * what creates the profile and assigns the role.
 */
model TeacherApplication {
  id     String @id @default(uuid())
  /// One open application per account. A rejected applicant who should be
  /// reconsidered has this row reopened rather than filing a second.
  userId String @unique

  fullName        String
  phone           String?
  specialization  String?
  yearsExperience Int?
  bio             String?

  /// The CV. Stored privately and reached through a short-lived signed URL —
  /// it carries a home address and phone number, so it must never sit in the
  /// public object namespace the rest of our uploads use.
  resumeFileId String @unique

  status       TeacherApplicationStatus @default(PENDING)
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation("TeacherApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("TeacherApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resumeFile FileUpload @relation("TeacherApplicationResume", fields: [resumeFileId], references: [id])

  @@index([status, createdAt])
  @@map("teacher_applications")
}

model ClassTeacher {
  teacherProfileId String
  classSectionId   String
  role             String   @default("PRIMARY") // PRIMARY, ASSISTANT, SUBSTITUTE
  assignedAt       DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, classSectionId])
  @@map("class_teachers")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model DailyAttendance {
  id               String           @id @default(uuid())
  studentProfileId String
  classSectionId   String
  date             DateTime         @db.Date
  status           AttendanceStatus
  remarks          String?
  recordedById     String? // User ID of teacher who recorded it
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, classSectionId, date])
  @@index([classSectionId, date])
  @@index([studentProfileId, date])
  @@map("daily_attendance")
}

/// One scheduled meeting of one cohort.
///
/// Absorbed `LiveClassSession` on 2026-08-17. A live class is authored once as
/// a `ModuleItem(kind: LIVE_CLASS)` inside a chapter, but each batch that buys
/// the course meets at its own time on its own link — so the curriculum slot
/// lives on the item and the meeting lives here. `moduleItemId` is the link
/// back; it is null for ad-hoc sessions that are not part of the outline.
model BatchSession {
  id           String    @id @default(uuid())
  batchId      String
  moduleItemId String?
  date         DateTime  @db.Date
  startTime    DateTime?
  endTime      DateTime?
  topic        String? // e.g. "Intro to Trees"

  // Meeting fields, inherited from the old LiveClassSession. `provider` stays
  // NONE until the Zoom Server-to-Server OAuth hook is implemented.
  teacherUserId     String?
  status            LiveClassStatus   @default(SCHEDULED)
  provider          LiveClassProvider @default(NONE)
  externalMeetingId String?
  joinUrl           String?
  startUrl          String?
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch      Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  moduleItem ModuleItem?       @relation(fields: [moduleItemId], references: [id], onDelete: SetNull)
  teacher    User?             @relation("HostedLiveClassSessions", fields: [teacherUserId], references: [id], onDelete: SetNull)
  attendance BatchAttendance[]

  @@index([batchId, date])
  @@index([moduleItemId])
  @@index([teacherUserId, date])
  @@map("batch_sessions")
}

model BatchAttendance {
  id               String           @id @default(uuid())
  studentProfileId String
  sessionId        String
  status           AttendanceStatus
  remarks          String?
  recordedById     String? // User ID of teacher who recorded it
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  session        BatchSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, sessionId])
  @@map("batch_attendance")
}

// ─── Homework ───────────────────────────────────────────────────────────────

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

/// A piece of work to hand in.
///
/// Reachable two ways, and exactly one of them is set:
///   - `moduleItemId` — a checkpoint inside a chapter, which is how a
///     self-paced learner gets homework at all.
///   - `batchId` — homework set for one cohort, the original shape.
///
/// Deliberately one model rather than two. The submission, grading and
/// gradebook paths are identical either way, and forking them would make every
/// count and every query ask "which kind?" forever.
model Homework {
  id             String    @id @default(uuid())
  moduleItemId   String?   @unique
  /// Was required. A self-paced buyer has no cohort, so demanding one meant
  /// they could not be set homework at all.
  batchId        String?
  title          String
  description    String?
  /// Null for a self-paced checkpoint, which is worked through whenever the
  /// learner reaches it. Cohort homework still sets one.
  dueDate        DateTime?
  maxPoints      Int
  attachmentUrls String[]  @default([])
  recordedById   String? // User ID of teacher who created it
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  moduleItem  ModuleItem?          @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  batch       Batch?               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@map("homeworks")
}

model HomeworkSubmission {
  id                String           @id @default(uuid())
  homeworkId        String
  studentProfileId  String
  /// Who actually handed it in, which is not always whose work it is: a child
  /// created through the family portal has no password and cannot sign in, so
  /// their guardian uploads on their behalf. The teacher marking this should be
  /// able to see that, rather than have it silently attributed to the child.
  /// Null for submissions predating this column.
  submittedByUserId String?
  submissionDate    DateTime         @default(now())
  content           String? // Submitted text or solution links
  status            SubmissionStatus @default(SUBMITTED)
  pointsEarned      Int?
  feedback          String?
  gradedById        String? // User ID of teacher who graded it
  gradedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  homework       Homework                       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile                 @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  submittedBy    User?                          @relation("HomeworkSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  attachments    HomeworkSubmissionAttachment[]

  @@unique([homeworkId, studentProfileId])
  // Declared to match what `20260821080000_homework_submitted_by` already
  // created. The migration indexed this FK deliberately; the model just never
  // said so, which left the migration chain and this schema permanently out of
  // step — invisible while CI built its database with `db push` (which works
  // from this file and never runs the migrations at all).
  @@index([submittedByUserId])
  @@map("homework_submissions")
}

/// A file handed in as part of a submission.
///
/// A join rather than a column on FileUpload, so a submission can carry several
/// files in a stated order, and so FileUpload stays a generic store rather than
/// accumulating a foreign key per feature that uses it.
///
/// The file itself is private: student work carries a child's name and often
/// their face or handwriting, so it must never sit in the public namespace the
/// rest of our uploads use. Reached only through the download route, which
/// checks who is asking.
model HomeworkSubmissionAttachment {
  id           String @id @default(uuid())
  submissionId String
  fileUploadId String @unique
  sortOrder    Int    @default(0)

  createdAt DateTime @default(now())

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file       FileUpload         @relation("HomeworkAttachment", fields: [fileUploadId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fileUploadId])
  @@index([submissionId])
  @@map("homework_submission_attachments")
}

// ─── Learning Catalog ───────────────────────────────────────────────────────

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PathUnlockMode {
  FREE_ROAM
  SEQUENTIAL
}

enum ConceptKind {
  CHAPTER
  CHECKPOINT
}

/// Catalogue taxonomy: groups Course, LearningPath and ClassSection.
///
/// NOT the same concept as the `Subject` model, which tags Assessment/Question rows only. The two
/// are unrelated — no foreign key, no shared rows.
model LearningSubject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses       Course[]
  paths         LearningPath[]
  classSections ClassSection[]

  @@map("learning_subjects")
}

/// K-6 grade-band tag on a Course. One Course already represents "one
/// subject's worth of content at one level", so Course is the natural
/// granularity for this rather than tagging Concept or LearningSubject.
///
/// Deliberately NOT superseded by the Class -> Program taxonomy: standalone
/// micro-courses (alphabet, times tables, fractions) belong to no Program and
/// therefore have no Class to derive a level from. `gradeBand` is the only
/// thing that categorises them, and it is what the public /kids browse route
/// filters on.
enum GradeBand {
  PRE_K_K
  G1_2
  G3_4
  G5_6
}

model Course {
  id                String        @id @default(uuid())
  learningSubjectId String
  title             String
  slug              String        @unique
  description       String?
  thumbnailUrl      String?
  /// Content effort ("12 hours of material"). Distinct from `durationWeeks`,
  /// which is calendar length — the two are unrelated numbers.
  estimatedHours    Int?
  durationWeeks     Int?
  status            CatalogStatus @default(DRAFT)
  sortOrder         Int           @default(0)
  gradeBand         GradeBand?
  deliveryMode      DeliveryMode  @default(SELF_PACED)

  /// Null = not sold a la carte; the Course is only reachable by buying a
  /// Program that contains it. Integer cents, never `Decimal`.
  priceOneTimeCents Int?
  priceMonthlyCents Int?
  installmentCount  Int?
  currency          String @default("USD")

  stripeProductId      String?
  stripePriceOneTimeId String?
  stripePriceMonthlyId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  learningSubject    LearningSubject           @relation(fields: [learningSubjectId], references: [id], onDelete: Cascade)
  concepts           Concept[]
  pathCourses        LearningPathCourse[]
  programCourses     ProgramCourse[]
  studentAssignments StudentCourseAssignment[]
  entitlements       Entitlement[]
  batches            Batch[]
  courseTeachers     CourseTeacher[]
  orderItems         OrderItem[]

  @@index([gradeBand])
  @@index([status])
  @@map("courses")
}

/// A guardian (or staff member) picking a catalog course for a specific
/// student — a curated "learning plan", NOT an access grant. Catalog content
/// is open to any authenticated student already (gated only by
/// `Course.status`); this only says "this is what
/// you should work on". Deliberately distinct from `StudentCourseEnrollment`,
/// which points at a term-bound `Batch` and carries real academic
/// weight (gradebook, attendance, homework) — the two models are unrelated.
model StudentCourseAssignment {
  id               String   @id @default(uuid())
  studentProfileId String
  courseId         String
  /// Who chose it — a guardian or a staff member. Kept so the student-facing
  /// UI can say who assigned it, and so staff can audit guardian actions.
  assignedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy     User           @relation("AssignedCourses", fields: [assignedByUserId], references: [id])

  @@unique([studentProfileId, courseId])
  @@map("student_course_assignments")
}

model LearningPath {
  id                String         @id @default(uuid())
  learningSubjectId String
  title             String
  slug              String         @unique
  description       String?
  unlockMode        PathUnlockMode @default(SEQUENTIAL)
  status            CatalogStatus  @default(DRAFT)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  learningSubject LearningSubject      @relation(fields: [learningSubjectId], references: [id], onDelete: Cascade)
  pathCourses     LearningPathCourse[]

  @@map("learning_paths")
}

model LearningPathCourse {
  id         String   @id @default(uuid())
  pathId     String
  courseId   String
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@map("learning_path_courses")
}

model Concept {
  id                   String      @id @default(uuid())
  name                 String      @unique
  description          String?
  courseId             String?
  sortOrder            Int         @default(1)
  kind                 ConceptKind @default(CHAPTER)
  passThresholdPercent Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  course  Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessons Lesson[]
  items   ModuleItem[]

  @@map("concepts")
}

// ─── Coursera-style Module Items ─────────────────────────────────────────────
// A second, coexisting content shape alongside Concept -> Lesson -> Card: a
// module (Concept) can also hold a flat, ordered sequence of ModuleItems —
// Video/Reading/Discussion/Assessment today. Deliberately no LESSON kind yet
// (folding existing Lesson/Card content in as a 5th kind is future work);
// enums are additive-safe so it can be appended later without a migration.

enum ModuleItemKind {
  VIDEO
  READING
  DISCUSSION
  ASSESSMENT
  /// Work handed in for a person to read, as a chapter checkpoint. The item is
  /// the slot; the `Homework` row hanging off it carries the brief, and each
  /// learner's `HomeworkSubmission` carries the answer.
  HOMEWORK
  /// The curriculum *slot* for a live session, not the meeting itself. One
  /// LIVE_CLASS item resolves to a different `BatchSession` for every cohort
  /// that buys the course, so the date and join link live there, not here.
  /// A course containing one of these is LIVE-only — see `assertDeliveryMode`.
  LIVE_CLASS
  /// A narrated, illustrated story the child listens to. The slot; the `Story`
  /// row hanging off it carries the chapters, segments and artwork.
  STORY
}

model ModuleItem {
  id                   String         @id @default(uuid())
  conceptId            String
  kind                 ModuleItemKind
  title                String
  sortOrder            Int            @default(1)
  status               CatalogStatus  @default(DRAFT)
  videoUrl             String?
  videoDurationSeconds Int?
  readingContent       String?
  assessmentId         String?
  /// Ungated even for anonymous visitors. A public course page with nothing
  /// playable converts badly and gives search engines nothing to index, so a
  /// few items per course are deliberately given away.
  isFreePreview        Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  concept    Concept              @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  assessment Assessment?          @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  progress   ModuleItemProgress[]
  discussion DiscussionThread?
  /// Populated only for LIVE_CLASS items — one row per cohort meeting.
  sessions   BatchSession[]
  /// Populated only for HOMEWORK items — the brief for this checkpoint.
  homework   Homework?
  /// Populated only for STORY items — the narrated story this slot contains.
  story      Story?

  @@map("module_items")
}

model ModuleItemProgress {
  id                  String    @id @default(uuid())
  moduleItemId        String
  studentProfileId    String
  completedAt         DateTime?
  lastPositionSeconds Int?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  moduleItem     ModuleItem     @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([moduleItemId, studentProfileId])
  @@map("module_item_progress")
}

// ─── Interactive stories ────────────────────────────────────────────────────
// A narrated, illustrated story a child listens to and can later ask questions
// about out loud. Hangs off `ModuleItem` the same way `Homework` does, so
// entitlement checks, the catalog and progress tracking all keep working with
// no new plumbing — a story is course content a family paid for, not a
// separate world beside one.
//
// Deliberately absent at this stage: anything about the voice agent. The
// conversation and turn records land with the agent itself, because their shape
// depends on decisions (moderation verdict format, cost fields) that have not
// been made yet, and guessing them now would bake the guess into a migration.

model Story {
  id String @id @default(uuid())

  /// The course slot this story fills, when it sits inside a course at all.
  ///
  /// Optional, because a story is a thing in its own right: it is written,
  /// narrated and read without belonging to anything, and attaching it to a
  /// chapter is one thing you may later choose to do with it. Requiring this
  /// meant no story could exist until someone had picked a course for it,
  /// which put a curriculum decision in front of writing.
  ///
  /// Still unique: one slot holds at most one story.
  moduleItemId String? @unique

  /// Whether students can find this story on its own, outside any course.
  ///
  /// Independent of the course binding — a story can be published to the
  /// library, sat in a course chapter, both, or neither. Reading it through a
  /// course still goes through the course's entitlement check; published here
  /// means free to read, which is what the library is for.
  status CatalogStatus @default(DRAFT)

  title        String
  /// One or two lines, used on the card and in search results.
  synopsis     String?
  coverAssetId String? @unique

  /// Who the story is written for. Same banding the public catalog filters on,
  /// so a story can sit in the same browse experience as everything else.
  gradeBand GradeBand?

  /// Freeform browse topics, stored in normalized lowercase form. A story can
  /// belong to several topics without coupling Moon to a fixed taxonomy.
  topics String[] @default([])

  /// Marks this story as readable by anyone, signed in or not, through the
  /// public demo routes.
  ///
  /// Deliberately a property of the story rather than a route that trusts its
  /// caller: the demo endpoints serve only stories carrying this flag, so paid
  /// course content cannot be reached through them even if someone guesses an
  /// id. Turning the demo off is one field, and it is visible in the data
  /// rather than buried in an environment variable.
  isPublicDemo Boolean @default(false)

  /// Overrides the server default narrator for this one story, so a story with
  /// a distinct character can keep its own voice. Null means "use the
  /// configured default". Holds a provider voice id, not a display name.
  narratorVoiceId String?

  /// Freeform notes the author writes for the voice agent — what this story is
  /// about, what it is teaching, what to do with an off-topic question. These
  /// become part of the agent's grounding once it exists; until then they are
  /// simply the author's intent, written down while it is fresh.
  agentGuidance String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleItem    ModuleItem?         @relation(fields: [moduleItemId], references: [id], onDelete: SetNull)
  cover         StoryAsset?         @relation("StoryCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  chapters      StoryChapter[]
  characters    StoryCharacter[]
  assets        StoryAsset[]        @relation("StoryAssets")
  conversations StoryConversation[]
  releases      StoryRelease[]

  @@map("stories")
}

model StoryRelease {
  id        String   @id @default(uuid())
  storyId   String
  revision  Int
  snapshot  Json
  mediaKeys String[]
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, revision])
  @@index([mediaKeys], type: Gin)
  @@map("story_releases")
}

model StoryChapter {
  id        String @id @default(uuid())
  storyId   String
  title     String
  sortOrder Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story    Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  segments StorySegment[]

  @@unique([storyId, sortOrder])
  @@index([storyId])
  @@map("story_chapters")
}

/// One paragraph or beat of the story — the unit narration is generated per,
/// and the unit playback position maps to.
///
/// This is the keystone for everything visual later. Because playback knows
/// which segment is sounding, changing an illustration mid-narration, moving a
/// camera or triggering a scene transition becomes "attach something to a
/// segment" rather than a rebuild. That is the entire reason segments exist as
/// rows rather than the chapter being one blob of text.
model StorySegment {
  id        String @id @default(uuid())
  chapterId String
  sortOrder Int    @default(1)

  text String

  /// The same words with emotion markup for the speech provider, e.g.
  /// "[nervously] She looked at the puddle.". Null narrates `text` flat.
  ///
  /// Held separately because the provider aligns its timings against whatever
  /// string it was given: narrating the tagged text and highlighting from its
  /// alignment would print the tags on the page. Stripping this must reproduce
  /// `text` exactly, and narration is refused when it does not — so the audio
  /// can never say something the page does not show.
  narrationText String?

  /// Storage key for this segment's generated narration, and how long it runs.
  /// Both null until narration is generated — the story is fully authorable and
  /// readable without audio.
  narrationAudioKey   String?
  narrationDurationMs Int?

  /// Character-level timing from the speech provider: `{ characters,
  /// character_start_times_seconds, character_end_times_seconds }`.
  ///
  /// Persisted rather than recomputed because it cannot be recovered from the
  /// audio afterwards — regenerating the narration to find out when a word is
  /// spoken would cost the synthesis again and return slightly different audio.
  /// This is what word highlighting, and later scene changes and camera moves,
  /// key off. Null when the provider gave no alignment.
  narrationTimings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter StoryChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  assets  StoryAsset[] @relation("SegmentAssets")

  @@unique([chapterId, sortOrder])
  @@index([chapterId])
  @@map("story_segments")
}

/// Artwork and other media. An asset bound to a segment is what changes while
/// that segment is being narrated; an unbound one is story-level art.
model StoryAsset {
  id        String  @id @default(uuid())
  storyId   String
  /// Null for story-level artwork such as the cover.
  segmentId String?

  kind       StoryAssetKind @default(ILLUSTRATION)
  /// Storage key. Never stored as a URL, and never handed out as one: reads go
  /// through this API's own media endpoint, which streams from local disk or
  /// redirects to a signed URL depending on the active backend.
  storageKey String
  /// Required for anything a child sees; stories are read by children who may
  /// use a screen reader.
  altText    String
  sortOrder  Int            @default(1)

  createdAt DateTime @default(now())

  story   Story         @relation("StoryAssets", fields: [storyId], references: [id], onDelete: Cascade)
  segment StorySegment? @relation("SegmentAssets", fields: [segmentId], references: [id], onDelete: Cascade)
  coverOf Story?        @relation("StoryCover")

  @@index([storyId])
  @@index([segmentId])
  @@map("story_assets")
}

enum StoryAssetKind {
  ILLUSTRATION
  BACKGROUND
  AUDIO
}

/// Named characters, so the agent can answer "who is Bramble?" from the story
/// rather than from whatever a general model imagines.
model StoryCharacter {
  id          String  @id @default(uuid())
  storyId     String
  name        String
  description String?
  sortOrder   Int     @default(1)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, name])
  @@index([storyId])
  @@map("story_characters")
}

/// One child's back-and-forth with the narrator about one story. Kept rather
/// than held in memory for two reasons: a guardian is entitled to see what
/// their child said to us, and the agent needs the last few turns to follow a
/// thread ("why did she do that?" refers to the previous answer).
model StoryConversation {
  id      String @id @default(uuid())
  storyId String

  /// Null on the public demo, where there is no account behind the visitor.
  studentProfileId String?

  /// Opaque id minted for an anonymous visitor so their demo conversation
  /// survives across requests. Null for a signed-in child, who is identified by
  /// studentProfileId instead. Exactly one of the two is set.
  demoSessionId String?

  /// Denormalised from `demoSessionId != null` so the daily demo ceiling can be
  /// counted straight off an index instead of joining to find out.
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story   Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  student StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  turns   StoryTurn[]

  @@index([storyId])
  @@index([studentProfileId])
  @@index([demoSessionId])
  @@index([isDemo, createdAt])
  @@map("story_conversations")
}

/// A single question and the narrator's answer.
model StoryTurn {
  id             String @id @default(uuid())
  conversationId String
  sortOrder      Int

  /// What the child asked, as transcribed. Stored as text even when it arrived
  /// as speech — the recording is not kept, only what it said.
  childText String
  replyText String

  /// Where in the story the question was asked. Grounds the answer, and lets a
  /// guardian see which page prompted it.
  segmentId String?

  createdAt DateTime @default(now())

  conversation StoryConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sortOrder])
  @@index([createdAt])
