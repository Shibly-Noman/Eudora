/**
 * One row per (user, installation) — a user signed into the app on two
 * phones holds two rows. `token` is unique on its own (not composite with
 * userId) because Expo push tokens are reissued per-install, not per-user;
 * registering the same token again just re-points it, e.g. after a
 * different account logs into the same device.
 */
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String // 'ios' | 'android' | 'web'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

enum DevicePairingStatus {
  PENDING
  APPROVED
  EXPIRED
}

/// A TV/device pairing code, used to authenticate a D-pad-only device (no
/// Play Services, no usable on-screen keyboard) by having the user approve
/// it from an already-authenticated phone session instead of typing a
/// password. See auth/device-pairing.service.ts.
/// A single-use, short-lived permission to set a new password without knowing
/// the old one.
///
/// Only the SHA-256 hash is stored, for the same reason as
/// `AuthSession.refreshTokenHash` and `DevicePairingCode.deviceCodeHash`:
/// possession of the raw token is equivalent to the account's password, so a
/// database leak must not hand over live reset links. The raw value exists
/// only in the email that was sent.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  /// Set the moment it is redeemed. A token is never valid twice — replaying
  /// an intercepted link after the owner has used it must fail.
  consumedAt  DateTime?
  /// Recorded for abuse investigation only; never used to authorise.
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model DevicePairingCode {
  id             String              @id @default(uuid())
  /// Short, human-typeable code shown on the TV and entered on the phone.
  code           String              @unique
  /// SHA-256 hash of the long polling secret the TV holds — kept hashed at
  /// rest for the same reason AuthSession.refreshTokenHash is: this secret,
  /// once approved, is equivalent to a login credential for the pairing user.
  deviceCodeHash String              @unique
  status         DevicePairingStatus @default(PENDING)
  userId         String?
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_pairing_codes")
}

model FileUpload {
  id           String   @id @default(uuid())
  /// Null for a private object: there is no public URL to hand out, and a
  /// placeholder here would eventually be rendered as one. Reach private files
  /// through a short-lived signed URL instead.
  url          String?
  /// Private objects live outside the public namespace and are only served
  /// through an endpoint that checks who is asking.
  isPrivate    Boolean  @default(false)
  key          String // Storage key/path
  bucket       String? // Storage bucket (S3)
  provider     String // "LOCAL" or "S3"
  size         Int
  mimetype     String
  originalName String
  userId       String
  createdAt    DateTime @default(now())
