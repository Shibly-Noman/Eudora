{
  "expo": {
    "name": "Eudora Moon",
    "slug": "eudora-moon",
    "scheme": "eudoramoon",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.eudora.moon" },
    "android": { "package": "com.eudora.moon" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-audio", { "enableBackgroundPlayback": true, "enableBackgroundRecording": false, "recordAudioAndroid": false }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
